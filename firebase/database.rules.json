{
    "rules": {
        ".read": false,
        ".write": false,
        "rooms": {
            "$roomId": {
                ".read": "auth != null && data.exists()",
                ".write": "auth != null && ((!data.exists() && newData.child('meta/hostUid').val() === auth.uid) || (!newData.exists() && data.child('meta/hostUid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['meta', 'players', 'sides'])",
                "meta": {
                    ".write": "auth != null && data.child('hostUid').val() === auth.uid",
                    ".validate": "newData.hasChildren(['schemaVersion', 'hostUid', 'status', 'createdAt', 'updatedAt', 'expiresAt']) && (!data.exists() || (newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
                    "schemaVersion": {
                        ".validate": "newData.isNumber() && newData.val() === 1"
                    },
                    "hostUid": {
                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                    },
                    "status": {
                        ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'active' || newData.val() === 'closed')"
                    },
                    "createdAt": {
                        ".validate": "newData.isNumber()"
                    },
                    "updatedAt": {
                        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                    },
                    "expiresAt": {
                        ".validate": "newData.isNumber() && newData.val() > newData.parent().child('createdAt').val() && newData.val() <= newData.parent().child('createdAt').val() + 2592000000"
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "players": {
                    "$uid": {
                        ".write": "auth != null && auth.uid === $uid",
                        ".validate": "newData.hasChildren(['displayName', 'role', 'connected', 'lastSeenAt'])",
                        "displayName": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
                        },
                        "role": {
                            ".validate": "newData.isString() && (newData.val() === 'host' || newData.val() === 'guest' || newData.val() === 'spectator')"
                        },
                        "connected": {
                            ".validate": "newData.isBoolean()"
                        },
                        "lastSeenAt": {
                            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "sides": {
                    "$sideId": {
                        ".write": "auth != null && newData.exists() && ($sideId === 'host' || $sideId === 'guest') && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
                        ".validate": "($sideId === 'host' || $sideId === 'guest') && newData.hasChildren(['ownerUid', 'ready', 'fleet']) && (!data.exists() || newData.child('ownerUid').val() === data.child('ownerUid').val())",
                        "ownerUid": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                        },
                        "ready": {
                            ".validate": "newData.isBoolean()"
                        },
                        "fleet": {
                            ".validate": "newData.hasChildren(['id', 'name', 'selectedFaction', 'limit', 'commander', 'flagshipId', 'rerolls'])",
                            "id": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                            },
                            "name": {
                                ".validate": "newData.isString() && newData.val().length <= 100"
                            },
                            "selectedFaction": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
                            },
                            "limit": {
                                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                            },
                            "commander": {
                                ".validate": "newData.isString() && newData.val().length <= 64"
                            },
                            "flagshipId": {
                                ".validate": "newData.isString() && newData.val().length <= 128"
                            },
                            "rerolls": {
                                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
                            },
                            "ships": {
                                "$shipIndex": {
                                    ".validate": "$shipIndex.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['id', 'classId', 'name', 'squadron']) && newData.child('id').isString() && newData.child('id').val().length <= 128 && newData.child('classId').isString() && newData.child('classId').val().length <= 128 && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('squadron').isString() && newData.child('squadron').val().length <= 100",
                                    "id": {
                                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                    },
                                    "classId": {
                                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                    },
                                    "name": {
                                        ".validate": "newData.isString() && newData.val().length <= 100"
                                    },
                                    "squadron": {
                                        ".validate": "newData.isString() && newData.val().length <= 100"
                                    },
                                    "upgrades": {
                                        "$upgradeIndex": {
                                            ".validate": "$upgradeIndex.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                        }
                                    },
                                    "torpedoResult": {
                                        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                                    },
                                    "$other": {
                                        ".validate": false
                                    }
                                }
                            },
                            "$other": {
                                ".validate": false
                            }
                        },
                        "battle": {
                            "$shipId": {
                                ".validate": "newData.hasChildren(['updatedAt', 'updatedBy']) && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').isNumber()",
                                "hull": {
                                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                                },
                                "shields": {
                                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                                },
                                "order": {
                                    ".validate": "newData.isString() && newData.val().length <= 64"
                                },
                                "criticalDamage": {
                                    "$entryIndex": {
                                        ".validate": "$entryIndex.matches(/^([0-9]|[1-4][0-9])$/) && newData.hasChildren(['id', 'typeId', 'source', 'status']) && newData.child('id').isString() && newData.child('id').val().length <= 128 && newData.child('typeId').isString() && newData.child('typeId').val().length <= 64 && newData.child('source').val() === 'manual' && (newData.child('status').val() === 'active' || newData.child('status').val() === 'repaired')"
                                    }
                                },
                                "message": {
                                    ".validate": "newData.isString() && newData.val().length <= 500"
                                },
                                "updatedAt": {
                                    ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                                },
                                "updatedBy": {
                                    ".validate": "newData.isString() && newData.val() === auth.uid"
                                },
                                "$other": {
                                    ".validate": false
                                }
                            }
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "$other": {
                    ".validate": false
                }
            }
        },
        "connectionTests": {
            "$roomId": {
                ".read": "auth != null && data.exists() && data.child('expiresAt').val() > now",
                ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || (!newData.exists() && data.child('hostUid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['hostUid', 'guestUid', 'createdAt', 'expiresAt', 'participants'])",
                "hostUid": {
                    ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())"
                },
                "guestUid": {
                    ".write": "auth != null && ((data.val() === false && newData.val() === auth.uid) || (data.val() === auth.uid && newData.val() === false))",
                    ".validate": "newData.val() === false || (newData.isString() && newData.val().length > 0 && newData.val().length <= 128)"
                },
                "createdAt": {
                    ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
                },
                "expiresAt": {
                    ".validate": "newData.isNumber() && newData.val() > newData.parent().child('createdAt').val() && newData.val() <= newData.parent().child('createdAt').val() + 90000000"
                },
                "participants": {
                    "$uid": {
                        ".write": "auth != null && auth.uid === $uid && ($uid === data.parent().parent().child('hostUid').val() || $uid === data.parent().parent().child('guestUid').val() || $uid === newData.parent().parent().child('guestUid').val())",
                        ".validate": "newData.hasChildren(['displayName', 'role', 'connected', 'joinedAt', 'lastSeenAt'])",
                        "displayName": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
                        },
                        "role": {
                            ".validate": "newData.isString() && (($uid === newData.parent().parent().parent().child('hostUid').val() && newData.val() === 'host') || ($uid === newData.parent().parent().parent().child('guestUid').val() && newData.val() === 'guest'))"
                        },
                        "connected": {
                            ".validate": "newData.isBoolean()"
                        },
                        "joinedAt": {
                            ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())"
                        },
                        "lastSeenAt": {
                            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "signal": {
                    ".write": "auth != null && data.parent().child('participants/' + auth.uid).exists()",
                    ".validate": "newData.hasChildren(['id', 'sentBy', 'sentAt']) && newData.child('sentBy').val() === auth.uid",
                    "id": {
                        ".validate": "newData.isString() && newData.val().length === 32"
                    },
                    "sentBy": {
                        ".validate": "newData.isString() && newData.val() === auth.uid"
                    },
                    "sentAt": {
                        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "$other": {
                    ".validate": false
                }
            }
        }
    }
}
