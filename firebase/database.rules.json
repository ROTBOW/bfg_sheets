{
    "rules": {
        ".read": false,
        ".write": false,
        "rooms": {
            "$roomId": {
                ".read": "auth != null && data.exists()",
                ".write": "auth != null && ((!data.exists() && newData.child('meta/hostUid').val() === auth.uid) || (!newData.exists() && data.child('meta/hostUid').val() === auth.uid))",
                ".validate": "newData.hasChildren(['meta', 'players', 'sides'])",
                "meta": {
                    ".write": "auth != null && data.child('hostUid').val() === auth.uid",
                    ".validate": "newData.hasChildren(['schemaVersion', 'hostUid', 'status', 'createdAt', 'updatedAt', 'expiresAt']) && (!data.exists() || (newData.child('hostUid').val() === data.child('hostUid').val() && newData.child('createdAt').val() === data.child('createdAt').val()))",
                    "schemaVersion": {
                        ".validate": "newData.isNumber() && newData.val() === 1"
                    },
                    "hostUid": {
                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                    },
                    "status": {
                        ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'active' || newData.val() === 'closed')"
                    },
                    "createdAt": {
                        ".validate": "newData.isNumber()"
                    },
                    "updatedAt": {
                        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                    },
                    "expiresAt": {
                        ".validate": "newData.isNumber() && newData.val() > newData.parent().child('createdAt').val() && newData.val() <= newData.parent().child('createdAt').val() + 2592000000"
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "players": {
                    "$uid": {
                        ".write": "auth != null && auth.uid === $uid",
                        ".validate": "newData.hasChildren(['displayName', 'role', 'connected', 'lastSeenAt'])",
                        "displayName": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
                        },
                        "role": {
                            ".validate": "newData.isString() && (newData.val() === 'host' || newData.val() === 'guest' || newData.val() === 'spectator')"
                        },
                        "connected": {
                            ".validate": "newData.isBoolean()"
                        },
                        "lastSeenAt": {
                            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "sides": {
                    "$sideId": {
                        ".write": "auth != null && newData.exists() && ($sideId === 'host' || $sideId === 'guest') && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
                        ".validate": "($sideId === 'host' || $sideId === 'guest') && newData.hasChildren(['ownerUid', 'ready', 'fleet']) && (!data.exists() || newData.child('ownerUid').val() === data.child('ownerUid').val())",
                        "ownerUid": {
                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                        },
                        "ready": {
                            ".validate": "newData.isBoolean()"
                        },
                        "fleet": {
                            ".validate": "newData.hasChildren(['id', 'name', 'selectedFaction', 'limit', 'commander', 'flagshipId', 'rerolls'])",
                            "id": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                            },
                            "name": {
                                ".validate": "newData.isString() && newData.val().length <= 100"
                            },
                            "selectedFaction": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
                            },
                            "limit": {
                                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
                            },
                            "commander": {
                                ".validate": "newData.isString() && newData.val().length <= 64"
                            },
                            "flagshipId": {
                                ".validate": "newData.isString() && newData.val().length <= 128"
                            },
                            "rerolls": {
                                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
                            },
                            "ships": {
                                "$shipIndex": {
                                    ".validate": "$shipIndex.matches(/^([0-9]|[1-9][0-9])$/) && newData.hasChildren(['id', 'classId', 'name', 'squadron']) && newData.child('id').isString() && newData.child('id').val().length <= 128 && newData.child('classId').isString() && newData.child('classId').val().length <= 128 && newData.child('name').isString() && newData.child('name').val().length <= 100 && newData.child('squadron').isString() && newData.child('squadron').val().length <= 100",
                                    "id": {
                                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                    },
                                    "classId": {
                                        ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                    },
                                    "name": {
                                        ".validate": "newData.isString() && newData.val().length <= 100"
                                    },
                                    "squadron": {
                                        ".validate": "newData.isString() && newData.val().length <= 100"
                                    },
                                    "upgrades": {
                                        "$upgradeIndex": {
                                            ".validate": "$upgradeIndex.matches(/^([0-9]|[12][0-9])$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                        }
                                    },
                                    "torpedoResult": {
                                        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
                                    },
                                    "$other": {
                                        ".validate": false
                                    }
                                }
                            },
                            "$other": {
                                ".validate": false
                            }
                        },
                        "battle": {
                            "$shipId": {
                                ".validate": "newData.hasChildren(['updatedAt', 'updatedBy']) && newData.child('updatedBy').val() === auth.uid && newData.child('updatedAt').isNumber()",
                                "hull": {
                                    ".write": "auth != null && data.parent().parent().parent().parent().parent().child('turn/activeSide').val() === ($sideId === 'host' ? 'guest' : 'host') && data.parent().parent().parent().parent().child($sideId === 'host' ? 'guest' : 'host').child('ownerUid').val() === auth.uid",
                                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (data.parent().parent().parent().child('ownerUid').val() === auth.uid || !data.exists() || newData.val() <= data.val())"
                                },
                                "shields": {
                                    ".write": "auth != null && data.parent().parent().parent().parent().parent().child('turn/activeSide').val() === ($sideId === 'host' ? 'guest' : 'host') && data.parent().parent().parent().parent().child($sideId === 'host' ? 'guest' : 'host').child('ownerUid').val() === auth.uid",
                                    ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (data.parent().parent().parent().child('ownerUid').val() === auth.uid || !data.exists() || newData.val() <= data.val())"
                                },
                                "order": {
                                    ".validate": "newData.isString() && newData.val().length <= 64"
                                },
                                "hasBlastMarker": {
                                    ".validate": "newData.isBoolean()"
                                },
                                "commandCheckFailed": {
                                    ".validate": "newData.isBoolean()"
                                },
                                "commandCheckPassed": {
                                    ".validate": "newData.isBoolean()"
                                },
                                "commandCheckRound": {
                                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
                                },
                                "commandCheckTurnSide": {
                                    ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'host' || newData.val() === 'guest')"
                                },
                                "spentOrdnance": {
                                    "$entryIndex": {
                                        ".validate": "$entryIndex.matches(/^([0-9]|[1-9][0-9])$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                                    }
                                },
                                "criticalDamage": {
                                    "$entryIndex": {
                                        ".validate": "$entryIndex.matches(/^([0-9]|[1-4][0-9])$/) && newData.hasChildren(['id', 'typeId', 'source', 'status']) && newData.child('id').isString() && newData.child('id').val().length <= 128 && newData.child('typeId').isString() && newData.child('typeId').val().length <= 64 && newData.child('source').val() === 'manual' && (newData.child('status').val() === 'active' || newData.child('status').val() === 'repaired')"
                                    }
                                },
                                "weaponFire": {
                                    "$entryIndex": {
                                        ".validate": "$entryIndex.matches(/^([0-9]|[1-9][0-9]|1[0-9][0-9])$/) && newData.hasChildren(['id', 'weaponIndex', 'weaponName', 'weaponType', 'round', 'turnSide', 'targetShipId', 'targetName', 'direction', 'mode', 'rolls', 'shots', 'hits', 'damage', 'accuracy', 'createdAt']) && (newData.child('weaponType').val() !== 'Lightning arc' || newData.hasChildren(['fireArc', 'allocatedStrength']))",
                                        "id": {
                                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                        },
                                        "weaponIndex": {
                                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                                        },
                                        "weaponName": {
                                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                                        },
                                        "weaponType": {
                                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
                                        },
                                        "round": {
                                            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
                                        },
                                        "turnSide": {
                                            ".validate": "newData.isString() && (newData.val() === 'host' || newData.val() === 'guest')"
                                        },
                                        "targetShipId": {
                                            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
                                        },
                                        "targetName": {
                                            ".validate": "newData.isString() && newData.val().length <= 100"
                                        },
                                        "direction": {
                                            ".validate": "newData.isString() && (newData.val() === 'closing' || newData.val() === 'moving-away' || newData.val() === 'abeam')"
                                        },
                                        "mode": {
                                            ".validate": "newData.isString() && (newData.val() === 'digital' || newData.val() === 'manual')"
                                        },
                                        "rolls": {
                                            "$rollIndex": {
                                                ".validate": "$rollIndex.matches(/^([0-9]|[1-9][0-9])$/) && newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
                                            }
                                        },
                                        "shots": {
                                            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
                                        },
                                        "hits": {
                                            ".validate": "newData.isNumber() && newData.val() >= 0 && ((newData.parent().child('weaponType').val() === 'Nova Cannon' && newData.val() <= 6) || newData.val() <= newData.parent().child('shots').val())"
                                        },
                                        "damage": {
                                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
                                        },
                                        "shieldBypassingDamage": {
                                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().child('damage').val()"
                                        },
                                        "accuracy": {
                                            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
                                        },
                                        "fireArc": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Lightning arc' && newData.isString() && (newData.val() === 'front' || newData.val() === 'left' || newData.val() === 'right' || newData.val() === 'rear')"
                                        },
                                        "allocatedStrength": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Lightning arc' && newData.isNumber() && newData.val() >= 1 && newData.val() <= 100"
                                        },
                                        "novaOutcome": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Nova Cannon' && newData.isString() && (newData.val() === 'center' || newData.val() === 'outer' || newData.val() === 'miss')"
                                        },
                                        "scatterResult": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Nova Cannon' && newData.isString() && (newData.val() === 'hit' || newData.val() === 'arrow')"
                                        },
                                        "scatterAngle": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Nova Cannon' && newData.isNumber() && newData.val() >= 0 && newData.val() <= 359"
                                        },
                                        "scatterDistance": {
                                            ".validate": "newData.parent().child('weaponType').val() === 'Nova Cannon' && newData.isNumber() && newData.val() >= 0 && newData.val() <= 18"
                                        },
                                        "createdAt": {
                                            ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
                                        },
                                        "$other": {
                                            ".validate": false
                                        }
                                    }
                                },
                                "message": {
                                    ".write": "auth != null && data.parent().parent().parent().parent().parent().child('turn/activeSide').val() === ($sideId === 'host' ? 'guest' : 'host') && data.parent().parent().parent().parent().child($sideId === 'host' ? 'guest' : 'host').child('ownerUid').val() === auth.uid",
                                    ".validate": "newData.isString() && newData.val().length <= 500"
                                },
                                "targetId": {
                                    ".validate": "newData.isString() && newData.val().length <= 128"
                                },
                                "leadership": {
                                    ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
                                },
                                "updatedAt": {
                                    ".write": "auth != null && data.parent().parent().parent().parent().parent().child('turn/activeSide').val() === ($sideId === 'host' ? 'guest' : 'host') && data.parent().parent().parent().parent().child($sideId === 'host' ? 'guest' : 'host').child('ownerUid').val() === auth.uid",
                                    ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                                },
                                "updatedBy": {
                                    ".write": "auth != null && data.parent().parent().parent().parent().parent().child('turn/activeSide').val() === ($sideId === 'host' ? 'guest' : 'host') && data.parent().parent().parent().parent().child($sideId === 'host' ? 'guest' : 'host').child('ownerUid').val() === auth.uid",
                                    ".validate": "newData.isString() && newData.val() === auth.uid"
                                },
                                "$other": {
                                    ".validate": false
                                }
                            }
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "signals": {
                    "$uid": {
                        ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('players/' + auth.uid).exists()",
                        ".validate": "newData.hasChildren(['id', 'sentAt'])",
                        "id": {
                            ".validate": "newData.isString() && newData.val().length === 32"
                        },
                        "sentAt": {
                            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                        },
                        "$other": {
                            ".validate": false
                        }
                    }
                },
                "turn": {
                    ".write": "auth != null && data.parent().child('players/' + auth.uid).exists()",
                    ".validate": "newData.hasChildren(['round', 'firstSide', 'activeSide'])",
                    "round": {
                        ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
                    },
                    "firstSide": {
                        ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'host' || newData.val() === 'guest')"
                    },
                    "activeSide": {
                        ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'host' || newData.val() === 'guest')"
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "report": {
                    ".write": "auth != null && data.parent().child('players/' + auth.uid).exists()",
                    ".validate": "newData.hasChildren(['status', 'result', 'startedAt', 'updatedAt', 'endedAt'])",
                    "status": {
                        ".validate": "newData.isString() && (newData.val() === 'active' || newData.val() === 'closed')"
                    },
                    "result": {
                        ".validate": "newData.isString() && newData.val().length <= 100"
                    },
                    "startedAt": {
                        ".validate": "newData.isNumber()"
                    },
                    "updatedAt": {
                        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                    },
                    "endedAt": {
                        ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                    },
                    "events": {
                        "$eventId": {
                            ".validate": "newData.hasChildren(['type', 'message', 'round', 'side', 'createdAt', 'createdBy']) && newData.child('createdBy').val() === auth.uid",
                            "type": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
                            },
                            "message": {
                                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
                            },
                            "round": {
                                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
                            },
                            "side": {
                                ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'host' || newData.val() === 'guest')"
                            },
                            "createdAt": {
                                ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                            },
                            "createdBy": {
                                ".validate": "newData.isString() && newData.val() === auth.uid"
                            },
                            "$other": {
                                ".validate": false
                            }
                        }
                    },
                    "$other": {
                        ".validate": false
                    }
                },
                "$other": {
                    ".validate": false
                }
            }
        }
    }
}
